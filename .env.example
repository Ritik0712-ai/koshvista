# Browser-visible configuration only. Never prefix secrets with VITE_.
VITE_NEON_AUTH_URL=
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
# Server only, configured on Neon Functions.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
APP_ORIGINS=http://127.0.0.1:5173
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DOCUMENT_BUCKET=source-documents
# Optional CLI administration (never shipped to browsers)
NEON_API_KEY=
# Deployment credentials: local/CI only, never VITE_ variables
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
