{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "koshvista",
  "compatibility_date": "2026-10-05",
  "send_metrics": false,
  "workers_dev": true,
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
