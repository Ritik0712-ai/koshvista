{
  "name": "koshvista",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx --env-file=.env.local server/dev.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:integration": "node --env-file=.env.local node_modules/.bin/vitest run tests/api.integration.test.ts",
    "format": "prettier --write src shared server tests scripts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/s3-request-presigner": "latest",
    "@fontsource/inter": "^5.2.0",
    "@hono/node-server": "latest",
    "@huggingface/transformers": "^3.8.1",
    "@neondatabase/auth": "latest",
    "@neondatabase/serverless": "latest",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.0",
    "decimal.js": "^10.6.0",
    "echarts": "^6.0.0",
    "hono": "latest",
    "jose": "^6.1.0",
    "lucide-react": "latest",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "latest",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tesseract.js": "latest",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "neon": "latest",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.147.0"
  }
}
